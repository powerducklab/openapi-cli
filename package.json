{
  "name": "@powerduck/openapi-cli",
  "version": "0.2.7",
  "description": "CI-ready CLI for batch-testing OpenAPI documents across HTTP, SSE, WebSocket, GraphQL, gRPC and MCP",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "openapi-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "check": "tsc --noEmit && vitest run"
  },
  "keywords": [
    "openapi",
    "cli",
    "testing",
    "grpc",
    "mcp",
    "graphql",
    "sse",
    "websocket",
    "ci",
    "api-testing",
    "contract-testing"
  ],
  "license": "MIT",
  "dependencies": {
    "@powerduck/openapi-parser": "^0.3.5",
    "@powerduck/openapi-request": "^0.2.7",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "terser": "^5.51.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerducklab/openapi-cli.git"
  },
  "bugs": {
    "url": "https://github.com/powerducklab/openapi-cli/issues"
  },
  "author": "POWERDUCK LIMITED",
  "homepage": "https://www.powerduck.com/",
  "publishConfig": {
    "access": "public"
  }
}
